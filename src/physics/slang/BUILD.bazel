load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools/slang:slang_rules.bzl", "slang_cpp", "slang_library")

package(default_visibility = ["//visibility:public"])

slang_library(
    name = "core",
    srcs = [
        "CanonicalFlow.slang",
        "Hamiltonian.slang",
        "KerrCoordinates.slang",
        "KerrSchild.slang",
        "KerrSchildDynamics.slang",
        "Metric.slang",
        "ModifiedDispersion.slang",
        "PhysicsConfig.slang",
        "PhysicsTypes.slang",
    ],
)

slang_cpp(
    name = "host_codegen",
    src = "HostExports.slang",
    deps = [":core"],
    import_paths = ["src/physics/slang"],
    output_name = "canonical_physics_generated",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "host_generated_cpp",
    srcs = [":host_codegen"],
    output_group = "cpp",
)

filegroup(
    name = "host_generated_hpp",
    srcs = [":host_codegen"],
    output_group = "hpp",
)

cc_library(
    name = "generated_host_physics",
    srcs = [":host_generated_cpp"],
    hdrs = [":host_generated_hpp"],
    copts = ["-std=c++17"],
    deps = ["@slang_toolchain//:host_prelude"],
)

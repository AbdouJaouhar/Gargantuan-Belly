load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

COPTS = [
    "-std=c++17",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wconversion",
    "-Wshadow",
]

cc_library(
    name = "scene_model",
    hdrs = ["src/scene/scene.hpp"],
    copts = COPTS,
)

cc_library(
    name = "scene_presets",
    srcs = ["src/scene/presets.cpp"],
    hdrs = ["src/scene/presets.hpp"],
    copts = COPTS,
    deps = [":scene_model"],
)

cc_library(
    name = "gpu_parameters",
    srcs = ["src/rendering/gpu_parameters.cpp"],
    hdrs = ["src/rendering/gpu_parameters.hpp"],
    copts = COPTS,
    deps = [":scene_model"],
)

cc_library(
    name = "vulkan_rendering",
    srcs = [
        "src/rendering/fullscreen_pipeline.cpp",
        "src/rendering/vulkan_instance.cpp",
    ],
    hdrs = [
        "src/rendering/fullscreen_pipeline.hpp",
        "src/rendering/vulkan_helpers.hpp",
        "src/rendering/vulkan_instance.hpp",
    ],
    copts = COPTS,
    linkopts = ["-lvulkan"],
)

cc_library(
    name = "sky_texture",
    srcs = ["src/rendering/sky_texture.cpp"],
    hdrs = ["src/rendering/sky_texture.hpp"],
    copts = COPTS,
    linkopts = ["-lz"],
    deps = [
        ":vulkan_rendering",
        "@tinyexr//:tinyexr",
    ],
)

cc_library(
    name = "vulkan_device_policy",
    hdrs = ["src/rendering/vulkan_device_policy.hpp"],
    copts = COPTS,
)

cc_library(
    name = "scene_controller",
    srcs = ["src/app/scene_controller.cpp"],
    hdrs = ["src/app/scene_controller.hpp"],
    copts = COPTS,
    linkopts = ["-lglfw"],
    deps = [
        ":scene_model",
        ":scene_presets",
    ],
)

cc_library(
    name = "parameter_menu",
    srcs = ["src/tools/ui/parameter_menu.cpp"],
    hdrs = ["src/tools/ui/parameter_menu.hpp"],
    copts = COPTS,
    deps = [
        ":scene_controller",
        "@imgui//:imgui",
    ],
)

cc_library(
    name = "interactive_app",
    srcs = [
        "src/app/frame_renderer.cpp",
        "src/app/lifecycle.cpp",
        "src/app/swapchain.cpp",
        "src/app/vulkan_device.cpp",
    ],
    hdrs = [
        "src/app/application.hpp",
    ],
    data = [
        "//assets/sky:nasa_star_map",
        "//shaders:black_hole_frag_spv",
        "//shaders:reissner_nordstrom_frag_spv",
        "//shaders:fullscreen_vert_spv",
    ],
    copts = COPTS,
    linkopts = ["-lglfw"],
    deps = [
        ":gpu_parameters",
        ":parameter_menu",
        ":scene_controller",
        ":sky_texture",
        ":vulkan_device_policy",
        ":vulkan_rendering",
        "@bazel_tools//tools/cpp/runfiles",
    ],
)

cc_binary(
    name = "gargantua",
    srcs = ["src/app/main.cpp"],
    copts = COPTS,
    deps = [":interactive_app"],
)

cc_library(
    name = "ppm_writer",
    srcs = ["src/io/ppm_writer.cpp"],
    hdrs = ["src/io/ppm_writer.hpp"],
    copts = COPTS,
)

cc_library(
    name = "high_precision_image_writer",
    srcs = ["src/io/high_precision_image_writer.cpp"],
    hdrs = ["src/io/high_precision_image_writer.hpp"],
    copts = COPTS,
    linkopts = ["-lz"],
)

cc_library(
    name = "offscreen_renderer",
    srcs = [
        "src/rendering/offscreen_cli.cpp",
        "src/rendering/offscreen_device.cpp",
        "src/rendering/offscreen_lifecycle.cpp",
        "src/rendering/offscreen_targets.cpp",
    ],
    hdrs = [
        "src/rendering/offscreen_renderer.hpp",
    ],
    data = [
        "//assets/sky:nasa_star_map",
        "//shaders:black_hole_frag_spv",
        "//shaders:reissner_nordstrom_frag_spv",
        "//shaders:fullscreen_vert_spv",
    ],
    copts = COPTS,
    deps = [
        ":gpu_parameters",
        ":high_precision_image_writer",
        ":scene_model",
        ":scene_presets",
        ":sky_texture",
        ":vulkan_device_policy",
        ":vulkan_rendering",
        "@bazel_tools//tools/cpp/runfiles",
    ],
)

cc_binary(
    name = "gargantua_headless",
    srcs = ["src/tools/render_still.cpp"],
    copts = COPTS,
    deps = [":offscreen_renderer"],
)

# Pure CPU diagnostic: intentionally has no Vulkan, GLFW, ImGui, scene, or
# renderer dependency.
cc_binary(
    name = "gargantua_physics_probe",
    srcs = ["src/tools/physics_probe.cpp"],
    copts = COPTS,
    deps = [
        "//src/physics:geometry_core",
        "//src/physics:metric_registry",
        "@eigen//:eigen",
    ],
)

cc_test(
    name = "scene_preset_test",
    srcs = ["tests/scene_preset_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [
        ":scene_model",
        ":scene_presets",
    ],
)

cc_test(
    name = "gpu_parameters_test",
    srcs = ["tests/gpu_parameters_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [
        ":gpu_parameters",
        ":scene_model",
        ":scene_presets",
    ],
)

cc_test(
    name = "scene_controller_test",
    srcs = ["tests/scene_controller_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [":scene_controller"],
)

cc_test(
    name = "physics_geometry_test",
    srcs = ["tests/physics_geometry_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [
        "//src/physics:geometry_core",
        "//src/physics:metric_registry",
        "//src/physics:standard_metrics",
        "@eigen//:eigen",
    ],
)

cc_test(
    name = "canonical_engine_test",
    srcs = ["tests/canonical_engine_test.cpp"],
    data = ["//shaders:quartic_dispersion_probe_spv"],
    copts = COPTS,
    size = "small",
    deps = [
        "//src/physics:canonical_engine",
        "//src/physics:canonical_dynamics",
        "//src/physics:standard_metrics",
    ],
)

cc_test(
    name = "metric_geodesic_system_test",
    srcs = ["tests/metric_geodesic_system_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [
        "//src/physics:metric_geodesic",
        "//src/physics:standard_metrics",
        "@eigen//:eigen",
    ],
)

cc_test(
    name = "geodesic_integration_test",
    srcs = ["tests/geodesic_integration_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [
        "//src/physics:hamiltonian_core",
        "//src/physics:canonical_dynamics",
        "//src/physics:canonical_metric",
        "//src/physics:metric_geodesic",
        "//src/physics:odeint",
        "//src/physics:standard_metrics",
        "@eigen//:eigen",
    ],
)

cc_test(
    name = "odeint_smoke_test",
    srcs = ["tests/odeint_smoke_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [
        "//src/physics:odeint",
        "@doctest//:doctest",
        "@doctest//:main",
    ],
)

cc_test(
    name = "ppm_writer_test",
    srcs = ["tests/ppm_writer_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [":ppm_writer"],
)

cc_test(
    name = "high_precision_image_writer_test",
    srcs = ["tests/high_precision_image_writer_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [":high_precision_image_writer"],
)

cc_test(
    name = "vulkan_device_policy_test",
    srcs = ["tests/vulkan_device_policy_test.cpp"],
    copts = COPTS,
    size = "small",
    deps = [":vulkan_device_policy"],
)

cc_test(
    name = "shader_interface_test",
    srcs = ["tests/shader_interface_test.cpp"],
    data = [
        "src/rendering/gpu_parameters.hpp",
        "//shaders:black_hole.slang",
        "//shaders:black_hole_frag_reflection",
        "//shaders:reissner_nordstrom_frag_reflection",
    ],
    copts = COPTS,
    size = "small",
    deps = ["@bazel_tools//tools/cpp/runfiles"],
)

test_suite(
    name = "tests",
    tests = [
        ":canonical_engine_test",
        ":gpu_parameters_test",
        ":geodesic_integration_test",
        ":high_precision_image_writer_test",
        ":metric_geodesic_system_test",
        ":odeint_smoke_test",
        ":physics_geometry_test",
        ":ppm_writer_test",
        ":scene_preset_test",
        ":scene_controller_test",
        ":shader_interface_test",
        ":vulkan_device_policy_test",
    ],
)
